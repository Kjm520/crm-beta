<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Haystack</AssemblyName>
    <RootNamespace>Haystack</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <Company>K1 Apps</Company>
    <Product>Haystack</Product>
    <Copyright>© 2026 K1 Apps</Copyright>
    <ApplicationIcon>Assets\haystack.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- App imagery embedded for XAML use. NOTE: the .ico is deliberately NOT here -
         it's claimed by <ApplicationIcon> and can't also be a Resource, so the
         title-bar mark uses this separate PNG copy instead. -->
    <Resource Include="Assets\Images\haystack-32.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <!-- Pin patched native SQLite: overrides transitive 2.1.11 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>

  <!-- Build number = the repo's commit count (K1's convention across projects).
       Captured from git on every build and baked into the assembly, where
       AppInfo reads it back · deliberately NOT an info file beside the exe,
       which the single-file publish would turn into a separable sibling again.
       Also appended to FileVersion (0.1.0 -> 0.1.0.247) so Explorer's file
       Properties shows the build. Falls back to 0 (displayed as "dev") when git
       or the repo isn't available. -->
  <Target Name="EmbedBuildNumber" BeforeTargets="GetAssemblyAttributes" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <PropertyGroup>
      <GitCommitCount Condition="'$(GitExitCode)' != '0' OR '$(GitCommitCount)' == ''">0</GitCommitCount>
      <GitCommitCount>$(GitCommitCount.Trim())</GitCommitCount>
      <FileVersion>$(FileVersion).$(GitCommitCount)</FileVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="BuildNumber" Value="$(GitCommitCount)" />
    </ItemGroup>
  </Target>

</Project>
