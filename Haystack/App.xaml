<Application x:Class="Haystack.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Haystack.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Active palette (colours only). Kept first so the brushes below
                     resolve against it; swapped at runtime by Haystack.Theming.ThemeManager,
                     which applies the saved theme at startup. Dark is loaded here because
                     it's the default for a new user — starting on the light palette would
                     paint one light frame before the swap for everyone who hasn't opted out. -->
                <ResourceDictionary Source="Resources/Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Resources/Themes/Colors.xaml" />
                <ResourceDictionary Source="Resources/Themes/Typography.xaml" />
                <ResourceDictionary Source="Resources/Themes/Controls.xaml" />
                <ResourceDictionary Source="Resources/Themes/DatePicker.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
            <converters:PhoneFormatConverter x:Key="PhoneFormatConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
