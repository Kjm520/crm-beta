<Window x:Class="Haystack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Haystack"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundDeepBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <!-- Corner rounding, the window border, and the drop shadow are all drawn
         natively by DWM (see Theming/NativeChrome), so nothing here rounds or
         outlines itself · the OS clips the window to its radius. -->
    <Border Background="{DynamicResource BackgroundDeepBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Height="32"
                    Background="{DynamicResource BackgroundMidBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" Margin="16,0,0,0">
                        <Image Source="/Assets/Images/haystack-32.png"
                               Width="16" Height="16" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="HAYSTACK"
                                   Style="{StaticResource TextSubheading}"
                                   VerticalAlignment="Center" />

                        <!-- Divider between brand and menu -->
                        <Border Width="1" Height="16"
                                Background="{DynamicResource BorderSubtleBrush}"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center" />

                        <!-- Custom File menu (in-house, themed; replaces native Menu) -->
                        <ToggleButton x:Name="FileMenuButton"
                                      Content="File"
                                      Style="{StaticResource MenuBarToggle}"
                                      Margin="4,0,0,0" />
                        <Popup x:Name="FileMenuPopup"
                               PlacementTarget="{Binding ElementName=FileMenuButton}"
                               Placement="Bottom" VerticalOffset="3"
                               StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=FileMenuButton}">
                            <Border Background="{DynamicResource BackgroundPanelBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="4" MinWidth="200" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.3" Direction="270" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="Settings"          Style="{StaticResource MenuDropItem}" Click="FileMenuSettings_Click" />
                                    <Button Content="Backup Database…"  Style="{StaticResource MenuDropItem}" Click="FileMenuBackup_Click" />
                                    <Border Height="1" Margin="6,4" Background="{DynamicResource BorderSubtleBrush}" />
                                    <Button Content="Exit"              Style="{StaticResource MenuDropItem}" Click="FileMenuExit_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">

                        <!-- Alert bell: badge shows how many things need attention
                             (AlertCenter derives them fresh on every refresh); the
                             popup lists them, click-through to the record. -->
                        <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                            <ToggleButton x:Name="AlertsButton"
                                          Style="{StaticResource MenuBarToggle}"
                                          Padding="7,4"
                                          Checked="AlertsButton_Checked">
                                <Path Data="M 8 1.5 C 5.6 1.5 4.1 3.4 4.1 6 L 4.1 9.2 L 2.8 11.2 L 13.2 11.2 L 11.9 9.2 L 11.9 6 C 11.9 3.4 10.4 1.5 8 1.5 Z M 6.6 13 A 1.5 1.5 0 0 0 9.4 13"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.2"
                                      StrokeLineJoin="Round"
                                      Width="16" Height="15" />
                            </ToggleButton>
                            <Border x:Name="AlertBadge"
                                    Background="{DynamicResource StatusRedBrush}"
                                    CornerRadius="7" Height="14" MinWidth="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-4,-5,0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="AlertCount"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="4,0" />
                            </Border>
                        </Grid>
                        <Popup x:Name="AlertsPopup"
                               PlacementTarget="{Binding ElementName=AlertsButton}"
                               StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=AlertsButton}">
                            <Border Background="{DynamicResource BackgroundPanelBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="6" Width="340" Margin="8,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.3" Direction="270" />
                                </Border.Effect>
                                <StackPanel x:Name="AlertsList" />
                            </Border>
                        </Popup>

                        <Button Style="{StaticResource WindowMinimizeButton}" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource WindowMaximizeButton}" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource WindowCloseButton}"    Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BackgroundMidBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <!-- Nav buttons are built in code from NavRegistry so their order
                         can be user-customized (see MainWindow.BuildNav). -->
                    <StackPanel x:Name="NavPanel" Margin="8,12">
                        <TextBlock Text="MENU"
                                   Style="{StaticResource TextCaption}"
                                   Margin="16,0,0,8" />
                    </StackPanel>
                </Border>

                <!-- Content area -->
                <ContentControl x:Name="MainContent" Grid.Column="1" />
            </Grid>

            <!-- Modal scrim: dims the whole window while a modal dialog is open.
                 Starts transparent and fades in/out (see MainWindow.ShowModal). -->
            <Border x:Name="ModalScrim"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="#66000000"
                    Opacity="0"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
