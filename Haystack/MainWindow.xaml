<Window x:Class="Haystack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Haystack"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundDeepBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Height="32"
                    Background="{DynamicResource BackgroundMidBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" Margin="16,0,0,0">
                        <Image Source="/Assets/Images/haystack-32.png"
                               Width="16" Height="16" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="HAYSTACK"
                                   Style="{StaticResource TextSubheading}"
                                   VerticalAlignment="Center" />

                        <!-- Divider between brand and menu -->
                        <Border Width="1" Height="16"
                                Background="{DynamicResource BorderSubtleBrush}"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center" />

                        <!-- Custom File menu (in-house, themed; replaces native Menu) -->
                        <ToggleButton x:Name="FileMenuButton"
                                      Content="File"
                                      Style="{StaticResource MenuBarToggle}"
                                      Margin="4,0,0,0" />
                        <Popup x:Name="FileMenuPopup"
                               PlacementTarget="{Binding ElementName=FileMenuButton}"
                               Placement="Bottom" VerticalOffset="3"
                               StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=FileMenuButton}">
                            <Border Background="{DynamicResource BackgroundPanelBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="4" MinWidth="200" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.3" Direction="270" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="Settings"          Style="{StaticResource MenuDropItem}" Click="FileMenuSettings_Click" />
                                    <Button Content="Backup Database…"  Style="{StaticResource MenuDropItem}" Click="FileMenuBackup_Click" />
                                    <Border Height="1" Margin="6,4" Background="{DynamicResource BorderSubtleBrush}" />
                                    <Button Content="Exit"              Style="{StaticResource MenuDropItem}" Click="FileMenuExit_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource WindowMinimizeButton}" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource WindowMaximizeButton}" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource WindowCloseButton}"    Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BackgroundMidBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <!-- Nav buttons are built in code from NavRegistry so their order
                         can be user-customized (see MainWindow.BuildNav). -->
                    <StackPanel x:Name="NavPanel" Margin="8,12">
                        <TextBlock Text="MENU"
                                   Style="{StaticResource TextCaption}"
                                   Margin="16,0,0,8" />
                    </StackPanel>
                </Border>

                <!-- Content area -->
                <ContentControl x:Name="MainContent" Grid.Column="1" />
            </Grid>

            <!-- Modal scrim: dims the whole window while a modal dialog is open.
                 Starts transparent and fades in/out (see MainWindow.ShowModal). -->
            <Border x:Name="ModalScrim"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="#66000000"
                    CornerRadius="10"
                    Opacity="0"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
