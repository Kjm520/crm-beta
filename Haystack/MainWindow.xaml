<Window x:Class="Haystack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Haystack"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundDeepBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Height="36"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <Image Source="/Assets/Images/haystack-32.png"
                               Width="16" Height="16" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="HAYSTACK"
                                   Style="{StaticResource TextSubheading}"
                                   VerticalAlignment="Center" />

                        <!-- Divider between brand and menu -->
                        <Border Width="1" Height="16"
                                Background="{StaticResource BorderSubtleBrush}"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center" />

                        <!-- Compact menu bar (VS Code style) -->
                        <Menu Background="Transparent"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0"
                              Foreground="{StaticResource TextSecondaryBrush}">
                            <Menu.Resources>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Padding" Value="7,3" />
                                </Style>
                            </Menu.Resources>
                            <MenuItem Header="_File">
                                <MenuItem Header="Settings" Click="Settings_Click" />
                                <Separator />
                                <MenuItem Header="Backup Database…" Click="BackupDatabase_Click" />
                                <Separator />
                                <MenuItem Header="Exit" Click="CloseButton_Click" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-4,0">
                        <Button Style="{StaticResource ButtonGhost}"
                                Width="26" Height="26" Padding="0"
                                Click="MinimizeButton_Click">
                            <Rectangle Width="10" Height="1"
                                       Fill="{StaticResource TextSecondaryBrush}"
                                       SnapsToDevicePixels="True" />
                        </Button>
                        <Button Style="{StaticResource ButtonGhost}"
                                Width="26" Height="26" Padding="0"
                                Click="MaximizeButton_Click">
                            <Border Width="10" Height="10"
                                    BorderBrush="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True" />
                        </Button>
                        <Button Style="{StaticResource ButtonClose}"
                                Width="26" Height="26" Padding="0"
                                Click="CloseButton_Click">
                            <Grid Width="10" Height="10">
                                <Line X1="0" Y1="0" X2="10" Y2="10"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1"
                                      SnapsToDevicePixels="True" />
                                <Line X1="0" Y1="10" X2="10" Y2="0"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1"
                                      SnapsToDevicePixels="True" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource BackgroundMidBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <!-- Nav buttons are built in code from NavRegistry so their order
                         can be user-customized (see MainWindow.BuildNav). -->
                    <StackPanel x:Name="NavPanel" Margin="8,12">
                        <TextBlock Text="MENU"
                                   Style="{StaticResource TextCaption}"
                                   Margin="16,0,0,8" />
                    </StackPanel>
                </Border>

                <!-- Content area -->
                <ContentControl x:Name="MainContent" Grid.Column="1" />
            </Grid>

            <!-- Modal scrim: dims the whole window while a modal dialog is open.
                 Starts transparent and fades in/out (see MainWindow.ShowModal). -->
            <Border x:Name="ModalScrim"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="#66000000"
                    CornerRadius="10"
                    Opacity="0"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
