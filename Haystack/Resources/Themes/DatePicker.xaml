<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         Themed DatePicker + Calendar (in-house replacement for the native,
         Win95-looking date flyout). Applied to the DatePicker in the Activity
         view via the ThemedDatePicker key. All colours come from the active
         palette via DynamicResource so it follows light/dark.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Prev / next month arrows -->
    <Style x:Key="CalendarNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width"  Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BackgroundElevatedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header title ("July 2026") -->
    <Style x:Key="CalendarHeaderButton" TargetType="Button">
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize"    Value="13" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Cursor"      Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BackgroundElevatedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Individual day cell -->
    <Style x:Key="ThemedCalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize"   Value="12" />
        <Setter Property="MinWidth"   Value="32" />
        <Setter Property="MinHeight"  Value="32" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Root" CornerRadius="5" Margin="1"
                            Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BackgroundElevatedBrush}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Month / year cell (year & decade views) -->
    <Style x:Key="ThemedCalendarButton" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize"   Value="12" />
        <Setter Property="MinWidth"   Value="42" />
        <Setter Property="MinHeight"  Value="42" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Root" CornerRadius="5" Margin="2"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BackgroundElevatedBrush}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentGlowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The month/header/grid container -->
    <Style x:Key="ThemedCalendarItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- Day-of-week header labels -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,2,0,6" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.32" Direction="270" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header: prev | title | next -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0" Style="{StaticResource CalendarNavButton}">
                                    <Path Data="M6,2 L2,6 L6,10" StrokeThickness="1.4"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource CalendarHeaderButton}" />
                                <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource CalendarNavButton}">
                                    <Path Data="M2,2 L6,6 L2,10" StrokeThickness="1.4"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                            </Grid>

                            <!-- Day grid (7 cols; row 0 = day-of-week titles, rows 1-6 = weeks) -->
                            <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,4,0,0" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                                    <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>

                            <!-- Year / decade grid (4 cols x 3 rows) -->
                            <Grid x:Name="PART_YearView" Grid.Row="1" Margin="0,4,0,0" Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar: themed surface + the styles above -->
    <Style x:Key="ThemedCalendar" TargetType="Calendar">
        <Setter Property="Background"  Value="{DynamicResource BackgroundPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ThemedCalendarDayButton}" />
        <Setter Property="CalendarButtonStyle"    Value="{StaticResource ThemedCalendarButton}" />
        <Setter Property="CalendarItemStyle"      Value="{StaticResource ThemedCalendarItem}" />
    </Style>

    <!-- The editable text part of the DatePicker -->
    <Style x:Key="ThemedDatePickerTextBox" TargetType="DatePickerTextBox">
        <Setter Property="Foreground"     Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush"     Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Background"     Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize"       Value="13" />
        <Setter Property="Padding"        Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The DatePicker itself: text box + calendar toggle + popup -->
    <Style x:Key="ThemedDatePicker" TargetType="DatePicker">
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background"       Value="{DynamicResource BackgroundElevatedBrush}" />
        <Setter Property="BorderBrush"      Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Height"           Value="32" />
        <Setter Property="CalendarStyle"    Value="{StaticResource ThemedCalendar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Style="{StaticResource ThemedDatePickerTextBox}"
                                               VerticalAlignment="Center" />

                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Focusable="False" Width="32" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                                            <Path Width="15" Height="15" Stretch="Uniform"
                                                  Data="M2,4 L14,4 L14,14 L2,14 Z M2,7 L14,7 M5,1.5 L5,4.5 M11,1.5 L11,4.5"
                                                  StrokeThickness="1.2"
                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BackgroundPanelBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Popup x:Name="PART_Popup"
                                   StaysOpen="False" AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Root}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
