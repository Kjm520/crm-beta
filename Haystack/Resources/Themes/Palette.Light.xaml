<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════
         LIGHT palette — colour values only.
         Brushes (Colors.xaml) reference these keys via DynamicResource so that
         swapping this dictionary for Palette.Dark.xaml at runtime recolours the
         whole app live. See Haystack.Theming.ThemeManager.
    ═══════════════════════════════════════════ -->

    <!-- Surfaces -->
    <Color x:Key="BackgroundDeepColor">#FFF5F7F5</Color>
    <Color x:Key="BackgroundMidColor">#FFFAFBFA</Color>
    <Color x:Key="BackgroundPanelColor">#FFFFFFFF</Color>
    <Color x:Key="BackgroundElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="BorderSubtleColor">#FFE0E5DF</Color>
    <Color x:Key="BorderAccentColor">#FFC2D4C0</Color>

    <!-- Accent -->
    <Color x:Key="AccentPrimaryColor">#FF3A9A5C</Color>
    <Color x:Key="AccentPrimaryHoverColor">#FF2E8B4E</Color>
    <Color x:Key="AccentGlowColor">#203A9A5C</Color>

    <!-- Status -->
    <Color x:Key="StatusGreenColor">#FF2D8E4F</Color>
    <Color x:Key="StatusAmberColor">#FFD4880E</Color>
    <Color x:Key="StatusRedColor">#FFD44030</Color>
    <Color x:Key="StatusGreenGlowColor">#202D8E4F</Color>
    <Color x:Key="StatusAmberGlowColor">#20D4880E</Color>
    <Color x:Key="StatusRedGlowColor">#20D44030</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FF1A2B1E</Color>
    <Color x:Key="TextSecondaryColor">#FF5A6E5E</Color>
    <Color x:Key="TextMutedColor">#FF94A698</Color>
    <Color x:Key="TextAccentColor">#FF3A9A5C</Color>

</ResourceDictionary>
