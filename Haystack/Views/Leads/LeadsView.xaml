<UserControl x:Class="Haystack.Views.Leads.LeadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Haystack.Views.Common">

    <UserControl.Resources>
        <!-- Single source of truth for this table's geometry: the header panel
             and every row lay out against this same spec (see TableRowPanel), so
             they can never disagree. Settings' LIST COLUMNS choices are applied
             to it in the constructor, before first layout. -->
        <common:TableColumns x:Key="Spec">
            <common:TableColumn Header="NAME"    Width="1.6*" SortMember="Name" />
            <common:TableColumn Header="COMPANY" Width="1.6*" SortMember="Company" />
            <common:TableColumn Header="PHONE"   Width="130"  SortMember="Phone" />
            <common:TableColumn Header="EMAIL"   Width="1.8*" SortMember="Email" />
            <common:TableColumn Header="STATUS"  Width="110"  SortMember="StatusName" />
            <common:TableColumn Header="CREATED" Width="110"  SortMember="CreatedAt" />
        </common:TableColumns>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, closed filter, search, actions on one row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Leads" Style="{StaticResource TextDisplaySmall}" Grid.Column="0" />

            <!-- Closed = finished (won / lost / dead — flagged per status in Settings).
                 Hidden from the list by default; this brings them back. -->
            <TextBlock Grid.Column="1" Text="Show closed"
                       Style="{StaticResource TextBodySecondary}"
                       VerticalAlignment="Bottom" Margin="0,0,0,8" />
            <CheckBox Grid.Column="2"
                      Style="{StaticResource ToggleSwitch}"
                      VerticalAlignment="Bottom"
                      Margin="8,0,16,5"
                      IsChecked="{Binding ShowClosed}" />

            <TextBox Grid.Column="3"
                     Width="260"
                     VerticalAlignment="Bottom"
                     Margin="0,0,12,0"
                     Style="{StaticResource SearchField}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="+ New Lead" Style="{StaticResource ButtonPrimary}"
                    Grid.Column="4" VerticalAlignment="Bottom"
                    Click="NewLead_Click" />
        </Grid>

        <!-- Lead list -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers (cells are built by TableHeader, which also sorts) -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,0">
                    <common:TableRowPanel x:Name="HeaderPanel" Height="34" />
                </Border>

                <!-- Rows -->
                <ListBox x:Name="RowsList" Grid.Row="1"
                         Style="{StaticResource ListTableRows}"
                         ItemsSource="{Binding Leads}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListTableRow}">
                            <EventSetter Event="MouseLeftButtonUp" Handler="LeadRow_Click" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <common:TableRowPanel Height="36" Columns="{StaticResource Spec}">
                                <TextBlock Text="{Binding Name}"    Style="{StaticResource CellPrimary}" />
                                <TextBlock Text="{Binding Company}" Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding Phone, Converter={StaticResource PhoneFormatConverter}}" Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding Email}"      Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding StatusName}" Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding CreatedAt, StringFormat='MMM d, yyyy'}" Style="{StaticResource CellSecondary}" />
                            </common:TableRowPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Text="No leads yet. Add one with + New Lead."
                           Style="{StaticResource TextBodySecondary}"
                           Margin="16,14,0,0"
                           IsHitTestVisible="False"
                           Visibility="{Binding Leads.Count, Converter={StaticResource ZeroToVisibleConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
