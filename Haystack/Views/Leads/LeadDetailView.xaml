<Window x:Class="Haystack.Views.Leads.LeadDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Haystack.Behaviors"
        Title="Lead"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDeepBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <!-- Rounding, border, and shadow are drawn natively by DWM (Theming/NativeChrome). -->
    <Border Background="{DynamicResource BackgroundDeepBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Height="32"
                    Background="{DynamicResource BackgroundMidBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Lead.DisplayName, FallbackValue='New Lead'}"
                               Style="{StaticResource TextSubheading}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                    <Button Grid.Column="1"
                            Style="{StaticResource WindowCloseButton}"
                            VerticalAlignment="Stretch"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">

                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Company is the primary field: in practice a lead IS a company. -->
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="COMPANY" Style="{StaticResource TextFieldLabel}" />
                                <TextBox x:Name="CompanyField"
                                         Style="{StaticResource InputField}"
                                         Text="{Binding Lead.Company, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="NAME (OPTIONAL)" Style="{StaticResource TextFieldLabel}" />
                                <TextBox Style="{StaticResource InputField}"
                                         Text="{Binding Lead.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="2">
                                <TextBlock Text="PHONE" Style="{StaticResource TextFieldLabel}" />
                                <TextBox Style="{StaticResource InputField}"
                                         behaviors:PhoneMaskBehavior.Enabled="True"
                                         Text="{Binding Lead.Phone, Converter={StaticResource PhoneFormatConverter},
                                                UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="2">
                                <TextBlock Text="EMAIL" Style="{StaticResource TextFieldLabel}" />
                                <TextBox Style="{StaticResource InputField}"
                                         Text="{Binding Lead.Email, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="4">
                                <TextBlock Text="STATUS" Style="{StaticResource TextFieldLabel}" />
                                <ComboBox Style="{StaticResource InputCombo}"
                                          ItemsSource="{Binding Statuses}"
                                          SelectedItem="{Binding SelectedStatus}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notes -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="NOTES" Style="{StaticResource TextFieldLabel}" />
                            <TextBox Style="{StaticResource InputField}"
                                     Height="120"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Lead.Notes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BackgroundMidBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="DeleteButton"
                                Content="Delete"
                                Style="{StaticResource ButtonGhost}"
                                Visibility="Collapsed"
                                Margin="0,0,12,0"
                                Click="Delete_Click" />
                        <Button x:Name="ConvertButton"
                                Content="Convert to Company"
                                Style="{StaticResource ButtonGhost}"
                                Visibility="Collapsed"
                                Click="Convert_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource ButtonGhost}"
                                Margin="0,0,12,0" Click="Close_Click" />
                        <Button Content="Save Lead" Style="{StaticResource ButtonPrimary}"
                                Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
