<UserControl x:Class="Haystack.Views.Companies.CompaniesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Haystack.Views.Common">

    <UserControl.Resources>
        <!-- Single source of truth for this table's geometry: the header panel
             and every row lay out against this same spec (see TableRowPanel), so
             they can never disagree. Settings' LIST COLUMNS choices are applied
             to it in the constructor, before first layout. -->
        <common:TableColumns x:Key="Spec">
            <common:TableColumn Header="NAME"         Width="2.4*" SortMember="Name" />
            <common:TableColumn Header="TYPE"         Width="110"  SortMember="Type" />
            <common:TableColumn Header="STATUS"       Width="90"   SortMember="Status" />
            <common:TableColumn Header="LOCATION"     Width="1.4*" SortMember="Location" />
            <common:TableColumn Header="CONTACTS"     Width="90"   SortMember="ContactCount" />
            <!-- LAST CONTACT displays a formatted string; sorts by the actual date. -->
            <common:TableColumn Header="LAST CONTACT" Width="120"  SortMember="LastInteractionDate" />
            <!-- DAYS SINCE displays "-" for never-contacted; sorts by the day count
                 (int.MaxValue for never, so they land last ascending). -->
            <common:TableColumn Header="DAYS SINCE"   Width="90"   SortMember="DaysSinceLastInteraction" />
        </common:TableColumns>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Companies" Style="{StaticResource TextDisplaySmall}" Grid.Column="0" />
            <Button Content="+ New Company" Style="{StaticResource ButtonPrimary}"
                    Grid.Column="1" VerticalAlignment="Bottom"
                    Click="NewCompany_Click" />
        </Grid>

        <!-- Search -->
        <TextBox Grid.Row="2"
                 Width="400"
                 HorizontalAlignment="Left"
                 Style="{StaticResource InputField}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Company list -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers (cells are built by TableHeader, which also sorts) -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <common:TableRowPanel x:Name="HeaderPanel" Height="34" />
                </Border>

                <!-- Rows -->
                <ListBox x:Name="RowsList" Grid.Row="1"
                         Style="{StaticResource ListTableRows}"
                         ItemsSource="{Binding Companies}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListTableRow}">
                            <EventSetter Event="MouseLeftButtonUp" Handler="CompanyRow_Click" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <common:TableRowPanel Height="36" Columns="{StaticResource Spec}">
                                <TextBlock Text="{Binding Name}"         Style="{StaticResource CellPrimary}" />
                                <TextBlock Text="{Binding Type}"         Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding Status}"       Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding Location}"     Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding ContactCount}" Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding LastInteractionDate, StringFormat='MMM d, yyyy'}" Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding DaysSinceLastInteractionDisplay}" Style="{StaticResource CellSecondary}" />
                            </common:TableRowPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
