<Window x:Class="Haystack.Views.Companies.CompanyDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Company"
        Width="760" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundDeepBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Height="36"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Company.Name, FallbackValue='New Company'}"
                               Style="{StaticResource TextSubheading}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ButtonClose}"
                            Width="26" Height="26" Padding="0"
                            Margin="0,0,-4,0"
                            Click="Close_Click">
                        <Grid Width="10" Height="10">
                            <Line X1="0" Y1="0" X2="10" Y2="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                            <Line X1="0" Y1="10" X2="10" Y2="0" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">

                    <!-- Company fields -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="NAME" Style="{StaticResource TextFieldLabel}" />
                                <TextBox Style="{StaticResource InputField}"
                                         Text="{Binding Company.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="PHONE" Style="{StaticResource TextFieldLabel}" />
                                <TextBox Style="{StaticResource InputField}"
                                         Text="{Binding Company.Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="2">
                                <TextBlock Text="TYPE" Style="{StaticResource TextFieldLabel}" />
                                <ComboBox Style="{StaticResource InputCombo}"
                                          ItemsSource="{Binding ContactTypes}"
                                          SelectedItem="{Binding Company.Type}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="2">
                                <TextBlock Text="STATUS" Style="{StaticResource TextFieldLabel}" />
                                <ComboBox Style="{StaticResource InputCombo}"
                                          ItemsSource="{Binding ContactStatuses}"
                                          SelectedItem="{Binding Company.Status}" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="4">
                                <TextBlock Text="CITY" Style="{StaticResource TextFieldLabel}" />
                                <TextBox Style="{StaticResource InputField}"
                                         Text="{Binding Company.City, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="4">
                                <TextBlock Text="STATE" Style="{StaticResource TextFieldLabel}" />
                                <TextBox Style="{StaticResource InputField}"
                                         Text="{Binding Company.State, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Contacts at this company -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CONTACTS" Style="{StaticResource TextSubheading}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="+ Add Contact"
                                        Style="{StaticResource ButtonGhost}"
                                        Click="AddContact_Click" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Contacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                Click="ContactRow_Click"
                                                Tag="{Binding Id}">
                                            <Border Padding="4,0" Background="Transparent">
                                                <Grid Height="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"  Style="{StaticResource TextBody}"          VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Phone}" Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No contacts yet."
                                       Style="{StaticResource TextBodySecondary}"
                                       Margin="4,8,0,0"
                                       Visibility="{Binding Contacts.Count, Converter={StaticResource ZeroToVisibleConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Rolled-up activity across all this company's contacts -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="ACTIVITY" Style="{StaticResource TextSubheading}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='MMM d'}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ContactName}" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource TextBody}" />
                                                    <TextBlock Text="{Binding Type}" Style="{StaticResource TextCaption}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No activity yet."
                                       Style="{StaticResource TextBodySecondary}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding Activity.Count, Converter={StaticResource ZeroToVisibleConverter}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource ButtonGhost}"
                            Margin="0,0,12,0" Click="Close_Click" />
                    <Button Content="Save Company" Style="{StaticResource ButtonPrimary}"
                            Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
