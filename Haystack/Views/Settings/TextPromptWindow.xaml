<Window x:Class="Haystack.Views.Settings.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundDeepBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Height="36"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource TextSubheading}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,20">
                <TextBlock x:Name="PromptText" Style="{StaticResource TextFieldLabel}" />
                <TextBox x:Name="InputField"
                         Style="{StaticResource InputField}"
                         Margin="0,4,0,0" />
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource ButtonGhost}"
                            Margin="0,0,12,0" Click="Cancel_Click" />
                    <Button Content="OK" Style="{StaticResource ButtonPrimary}"
                            Click="Ok_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
