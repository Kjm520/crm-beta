<Window x:Class="Haystack.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="660" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundDeepBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Height="36"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Settings"
                               Style="{StaticResource TextSubheading}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ButtonClose}"
                            Width="26" Height="26" Padding="0"
                            Margin="0,0,-4,0"
                            Click="Close_Click">
                        <Grid Width="10" Height="10">
                            <Line X1="0" Y1="0" X2="10" Y2="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                            <Line X1="0" Y1="10" X2="10" Y2="0" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">

                    <!-- Navigation tab order -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="NAVIGATION" Style="{StaticResource TextSubheading}" Margin="0,0,0,4" />
                            <TextBlock Text="Reorder the tabs in the left panel."
                                       Style="{StaticResource TextBodySecondary}"
                                       Margin="0,0,0,12" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding NavItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Up"
                                                        Style="{StaticResource ButtonGhost}"
                                                        Padding="12,4" FontSize="12" Margin="0,0,8,0"
                                                        Click="MoveNavUp_Click" Tag="{Binding}" />
                                                <Button Grid.Column="2" Content="Down"
                                                        Style="{StaticResource ButtonGhost}"
                                                        Padding="12,4" FontSize="12"
                                                        Click="MoveNavDown_Click" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Lead statuses (user-editable) -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LEAD STATUSES" Style="{StaticResource TextSubheading}" Margin="0,0,0,4" />
                            <TextBlock Text="Deleting a status keeps its leads; they simply become unassigned."
                                       Style="{StaticResource TextBodySecondary}"
                                       Margin="0,0,0,12" TextWrapping="Wrap" />

                            <!-- Existing statuses -->
                            <ItemsControl ItemsSource="{Binding LeadStatuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           Style="{StaticResource TextCaption}">
                                                    <Run Text="{Binding LeadCount, Mode=OneWay}" />
                                                    <Run Text="leads" />
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="Rename"
                                                        Style="{StaticResource ButtonGhost}"
                                                        Padding="10,4" FontSize="12" Margin="0,0,8,0"
                                                        Click="RenameStatus_Click"
                                                        Tag="{Binding}" />
                                                <Button Grid.Column="3" Content="Delete"
                                                        Style="{StaticResource ButtonGhost}"
                                                        Padding="10,4" FontSize="12"
                                                        Click="DeleteStatus_Click"
                                                        Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add new status -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource InputField}"
                                         Text="{Binding NewStatusName, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Add Status"
                                        Style="{StaticResource ButtonPrimary}"
                                        Click="AddStatus_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Data -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DATA" Style="{StaticResource TextSubheading}" Margin="0,0,0,6" />
                            <TextBlock Text="Backup and data-management options will appear here. (Backup is currently available under File.)"
                                       Style="{StaticResource TextBodySecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="ABOUT" Style="{StaticResource TextSubheading}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Application" Style="{StaticResource TextBodySecondary}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Haystack"    Style="{StaticResource TextBody}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Publisher"   Style="{StaticResource TextBodySecondary}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="K1 Apps"     Style="{StaticResource TextBody}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Style="{StaticResource ButtonPrimary}"
                            Click="Close_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
