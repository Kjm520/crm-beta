<Window x:Class="Haystack.Views.Dialogs.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDeepBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <!-- Rounding, border, and shadow are drawn natively by DWM (Theming/NativeChrome). -->
    <Border Background="{DynamicResource BackgroundDeepBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Height="32"
                    Background="{DynamicResource BackgroundMidBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource TextSubheading}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Body: what's being acted on, then what the action will do. -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock x:Name="SubjectText"
                           Style="{StaticResource TextBody}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource TextBodySecondary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Footer. The shared button styles are sized for the big detail modals,
                 where a 24,12 bar with 20,9 buttons is in proportion. This dialog is a
                 fraction of that height, so the same footer read as a slab — hence the
                 tighter padding here. Deliberately local: the large modals still want
                 the full-size version. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BackgroundMidBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Cancel" Style="{StaticResource ButtonGhost}"
                            Padding="14,6" FontSize="12"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton"
                            Padding="16,6" FontSize="12"
                            Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
