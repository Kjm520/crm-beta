<UserControl x:Class="Haystack.Views.Activity.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Activity" Style="{StaticResource TextDisplaySmall}" />

        <!-- Log new interaction -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="LOG ACTIVITY" Style="{StaticResource TextSubheading}" Margin="0,0,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CONTACT" Style="{StaticResource TextFieldLabel}" />
                        <ComboBox Style="{StaticResource InputCombo}"
                                  ItemsSource="{Binding ContactList}"
                                  SelectedItem="{Binding SelectedContact}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SUMMARY" Style="{StaticResource TextFieldLabel}" />
                        <TextBox Style="{StaticResource InputField}"
                                 Text="{Binding NewInteractionSummary, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="TYPE" Style="{StaticResource TextFieldLabel}" />
                        <ComboBox Style="{StaticResource InputCombo}"
                                  ItemsSource="{Binding InteractionTypes}"
                                  SelectedItem="{Binding NewInteractionType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="DATE" Style="{StaticResource TextFieldLabel}" />
                        <DatePicker SelectedDate="{Binding NewInteractionDate}"
                                    Style="{StaticResource ThemedDatePicker}" />
                    </StackPanel>
                </Grid>
                <Button Content="Log" Style="{StaticResource ButtonPrimary}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Command="{Binding LogCommand}" />
            </StackPanel>
        </Border>

        <!-- Activity feed -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16">
                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource TextSubheading}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Date, StringFormat='MMM d, yyyy'}"
                                                   Style="{StaticResource TextCaption}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ContactName}"
                                                   Style="{StaticResource TextBody}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource TextBody}" />
                                            <TextBlock Text="{Binding Type}" Style="{StaticResource TextCaption}" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Content="✕" Style="{StaticResource ButtonGhost}"
                                                Width="28" Height="24" Padding="0" FontSize="10"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No activity logged yet."
                               Style="{StaticResource TextBodySecondary}"
                               Margin="0,8,0,0"
                               Visibility="{Binding Activity.Count,
                                   Converter={StaticResource ZeroToVisibleConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
