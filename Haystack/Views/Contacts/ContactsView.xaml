<UserControl x:Class="Haystack.Views.Contacts.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Contacts" Style="{StaticResource TextDisplaySmall}" Grid.Column="0" />
            <Button Content="+ New Contact" Style="{StaticResource ButtonPrimary}"
                    Grid.Column="1" VerticalAlignment="Bottom"
                    Click="NewContact_Click" />
        </Grid>

        <!-- Search -->
        <TextBox Grid.Row="2"
                 Style="{StaticResource InputField}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 MaxWidth="400"
                 HorizontalAlignment="Left">
            <TextBox.Resources>
                <Style TargetType="TextBox" BasedOn="{StaticResource InputField}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <DrawingBrush Stretch="None" AlignmentX="Left">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="Transparent" />
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Contact list -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <Grid Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NAME"         Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="COMPANY"      Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="TYPE"         Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="STATUS"       Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="LOCATION"     Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="LAST CONTACT" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="DAYS SINCE"   Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Contacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}"
                                        Click="ContactRow_Click"
                                        Tag="{Binding Id}">
                                    <Border Padding="16,0" Background="Transparent">
                                        <Grid Height="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"    Style="{StaticResource TextBody}"          VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompanyName}" Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Type}"    Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Status}"  Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Location}" Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="5" Text="{Binding LastInteractionDate, StringFormat='MMM d, yyyy'}" Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding DaysSinceLastInteractionDisplay}"                 Style="{StaticResource TextBodySecondary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
