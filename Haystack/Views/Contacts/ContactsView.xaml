<UserControl x:Class="Haystack.Views.Contacts.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Haystack.Views.Common">

    <UserControl.Resources>
        <!-- Single source of truth for this table's geometry: the header panel
             and every row lay out against this same spec (see TableRowPanel), so
             they can never disagree. The user's saved column choices (header
             right-click menu) are applied to it in the constructor, before
             first layout. -->
        <common:TableColumns x:Key="Spec">
            <common:TableColumn Header="NAME"         Width="2*"   SortMember="Name" />
            <common:TableColumn Header="COMPANY"      Width="2*"   SortMember="CompanyName" />
            <common:TableColumn Header="TYPE"         Width="110"  SortMember="Type" />
            <common:TableColumn Header="STATUS"       Width="90"   SortMember="Status" />
            <common:TableColumn Header="LOCATION"     Width="1.3*" SortMember="Location" />
            <!-- LAST CONTACT displays a formatted string; sorts by the actual date. -->
            <common:TableColumn Header="LAST CONTACT" Width="120"  SortMember="LastInteractionDate" />
            <!-- DAYS SINCE displays "-" for never-contacted; sorts by the day count
                 (int.MaxValue for never, so they land last ascending). -->
            <common:TableColumn Header="DAYS SINCE"   Width="90"   SortMember="DaysSinceLastInteraction" />
            <!-- MAINTENANCE is the contact cadence ("every N days" from the detail
                 view); ships hidden · shown via the header's right-click menu.
                 Displays "-" for unmonitored; sorts by the day count (int.MaxValue
                 for unmonitored, so they land last ascending). -->
            <common:TableColumn Header="MAINTENANCE"  Width="110"  SortMember="ContactEveryDaysSort" Visible="False" />
        </common:TableColumns>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, search, actions on one row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Contacts" Style="{StaticResource TextDisplaySmall}" Grid.Column="0" />
            <TextBox Grid.Column="1"
                     Width="260"
                     VerticalAlignment="Bottom"
                     Margin="0,0,12,0"
                     Style="{StaticResource SearchField}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="+ New Contact" Style="{StaticResource ButtonPrimary}"
                    Grid.Column="2" VerticalAlignment="Bottom"
                    Click="NewContact_Click" />
        </Grid>

        <!-- Contact list -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers (cells are built by TableHeader, which also sorts) -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,0">
                    <common:TableRowPanel x:Name="HeaderPanel" Height="34" />
                </Border>

                <!-- Rows -->
                <ListBox x:Name="RowsList" Grid.Row="1"
                         Style="{StaticResource ListTableRows}"
                         ItemsSource="{Binding Contacts}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListTableRow}">
                            <EventSetter Event="MouseLeftButtonUp" Handler="ContactRow_Click" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <common:TableRowPanel Height="36" Columns="{StaticResource Spec}">
                                <TextBlock Text="{Binding Name}"        Style="{StaticResource CellPrimary}" />
                                <TextBlock Text="{Binding CompanyName}" Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding Type}"        Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding Status}"      Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding Location}"    Style="{StaticResource CellSecondary}" />
                                <TextBlock Text="{Binding LastInteractionDate, StringFormat='MMM d, yyyy'}" Style="{StaticResource CellSecondary}" />
                                <!-- Reddens when past this contact's contact cadence. -->
                                <TextBlock Text="{Binding DaysSinceLastInteractionDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellSecondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusRedBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ContactEveryDaysDisplay}" Style="{StaticResource CellSecondary}" />
                            </common:TableRowPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
